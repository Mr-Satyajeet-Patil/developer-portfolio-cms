# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local MySQL (used when DATABASE_URL is empty)
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=3306

# Production database. Set this to a PostgreSQL URL (for example a free Neon
# database) and the DB_* values above are ignored.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: only needed when the frontend is hosted on a different origin or
# the site uses a custom domain.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
